# Every variable is optional: the site builds and runs with none of them set.
# Blank values are treated as "not set". Keep comments on their own lines
# (Vercel's "paste .env" importer does not strip inline comments).

# ─── Site ─────────────────────────────────────────────────────────────
# Canonical URL for OG tags, JSON-LD and reschedule links.
# If unset, Vercel's production domain is used, then https://workolo.io.
NEXT_PUBLIC_SITE_URL=https://workolo.io

# ─── Tracking (scripts load only when a valid id is set) ─────────────
# GA4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Meta Pixel id, digits only
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Booking backend ─────────────────────────────────────────────────
# mock | calcom | google | n8n. Optional: if blank, Cal.com is used automatically
# when CALCOM_API_KEY + CALCOM_EVENT_TYPE_ID are set; production never falls back
# to the mock. Check what's live at /api/health.
BOOKING_ADAPTER=

# Schedule rules for mock / google / n8n (Cal.com uses its own availability).
# Zone the 6:30–9:00 PM start times are anchored in.
BOOKING_HOST_TZ=Asia/Karachi
BOOKING_MIN_NOTICE_HOURS=12
BOOKING_HORIZON_DAYS=45

# Cal.com (BOOKING_ADAPTER=calcom)
# API key (cal_live_...) and the numeric id of the 30-min event type.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_API_URL=https://api.cal.com/v2

# Google Calendar (BOOKING_ADAPTER=google)
# Calendar id, service account email, and its PEM private key (\n escaped is fine).
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# n8n (BOOKING_ADAPTER=n8n)
# Booking webhook is required; availability webhook and secret are optional.
N8N_BOOKING_WEBHOOK_URL=
N8N_AVAILABILITY_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
