# ─── Site ─────────────────────────────────────────────────────────────
# Absolute URL, used for canonical/OG tags, JSON-LD and reschedule links.
NEXT_PUBLIC_SITE_URL=https://workolo.io

# ─── Tracking (optional; scripts load only when set) ─────────────────
NEXT_PUBLIC_GA4_ID=            # e.g. G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=     # e.g. 1234567890

# ─── Booking backend ─────────────────────────────────────────────────
# mock | calcom | google | n8n   (default: mock)
BOOKING_ADAPTER=mock

# Schedule rules used by mock / google / n8n (Cal.com uses its own availability)
BOOKING_HOST_TZ=Asia/Karachi   # zone the 6:30–9:00 PM start times are anchored in
BOOKING_MIN_NOTICE_HOURS=12
BOOKING_HORIZON_DAYS=45

# Cal.com (BOOKING_ADAPTER=calcom)
CALCOM_API_KEY=                # cal_live_...
CALCOM_EVENT_TYPE_ID=          # numeric id of the 30-min "Discovery Meeting" event type
CALCOM_API_URL=https://api.cal.com/v2

# Google Calendar (BOOKING_ADAPTER=google)
GOOGLE_CALENDAR_ID=            # e.g. salman@workolo.io or the calendar's id
GOOGLE_SERVICE_ACCOUNT_EMAIL=  # xxx@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=            # "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# n8n (BOOKING_ADAPTER=n8n)
N8N_BOOKING_WEBHOOK_URL=
N8N_AVAILABILITY_WEBHOOK_URL=  # optional
N8N_WEBHOOK_SECRET=            # optional, sent as x-workolo-secret
